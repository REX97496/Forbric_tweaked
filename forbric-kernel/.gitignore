# Local game instances. Keep probe source in canary/ (outside run/), and tools in run/compat/.
/.dev/
# The isolated compatibility-test instance (mc-dir + staged + client/server), built by tools/dev.py into
# .dev-test/ by design so it does not touch .dev/. 490 MB of copied artifacts and the fetched mods;
# never tracked. It was tracked once by accident -- see the commit that added this line.
/.dev-test/
# Ignore whole instance trees so new game/mod output does not require another per-gate rule.
/run/client-*/
/run/server-*/
/run/ac-client/
/run/ac-server/
/run/fab-client/
/run/fab-server/
/run/fnet-client/
/run/fnet-server/
/run/fhs-client/
/run/fhs-server/
/run/mp-client/
/run/mp-server/
/run/parity-*/
/run/savedrop/
/run/world-events-m49/
/run/compat-world/
/run/installed/

# Generated probe jars and hash manifests; their sources live in /canary/.
/run/canary/
/run/energy-api/
/run/carry-on/
/run/.gate-downloads/
/run/.gate-clones/

# Gate bookkeeping and runtime output in any custom run/ instance directory.
.forbric-gate.pid
.forbric-java.args
.forbric-launch.json
/run/*/server.properties
/run/*/eula.txt
/run/*/usercache.json
/run/*/banned-*.json
/run/*/ops.json
/run/*/whitelist.json
/run/*/.mixin.out/
/run/*/logs/
/run/*/journeymap/
